# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# In development: supply your MongoDB Atlas connection string (or local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/encore_dev?retryWrites=true&w=majority

# JWT Authentication Secret & Expiry
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=1d

# Client URL for CORS
CORS_ORIGIN=http://localhost:5173

# Client origin used to build Stripe redirect/return URLs
CLIENT_URL=http://localhost:5173

# Seat hold lifetime before the reaper releases it back to available
HOLD_TTL_MINUTES=10

# How long a signed email-verification link stays valid before expiring
VERIFY_TOKEN_TTL_HOURS=24

# How long a signed password-reset link stays valid before expiring
RESET_TOKEN_TTL_MINUTES=30

# How often the background payment reconciler sweeps for paid-but-unconfirmed
# holds (ADR-014, FR-39) — see server/src/jobs/paymentReconciler.js
RECONCILE_INTERVAL_MINUTES=2

# Stripe (test mode) — see https://dashboard.stripe.com/test/apikeys
# No webhook signing secret needed: payment confirmation is by server-side
# PaymentIntent retrieval, not an inbound webhook (ADR-014).
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_CURRENCY=lkr

# Email (nodemailer). Leave SMTP_HOST blank in development to fall back to
# an auto-created Ethereal test account (preview URL logged on send).
EMAIL_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Encore <no-reply@encore.live>

# SMS (notify.lk) — https://notify.lk
SMS_ENABLED=true
NOTIFYLK_USER_ID=your_notifylk_user_id
NOTIFYLK_API_KEY=your_notifylk_api_key
NOTIFYLK_SENDER_ID=NotifyDEMO

# Structured logging (pino)
LOG_LEVEL=info
